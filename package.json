{
  "name": "venus",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @venus/web dev",
    "build": "pnpm --filter @venus/web build",
    "test": "pnpm --filter @venus/web test",
    "test:e2e": "pnpm --filter @venus/web test:e2e",
    "test:e2e:m1": "pnpm --filter @venus/web test:e2e:m1",
    "sync:up": "docker compose up --build postgres octobase",
    "sync:down": "docker compose down"
  },
  "pnpm": {
    "overrides": {
      "yjs": "13.6.32"
    }
  }
}
