# Talk to Compose hub (`pnpm sync:up`). Leave unset for memory-only `pnpm dev`.
# VITE_SYNC_URL=ws://127.0.0.1:3000/collaboration/77e4a2b1-8b40-5979-a73c-fd4477216d00
#
# Compose/k8s `web` bakes VITE_SYNC_URL=same-origin (WS + /api on the page origin).
# Do not use same-origin with host Vite unless you also proxy /collaboration.
#
# Host Flush + git-log chrome (hidden when unset). Sidecar must be up on :3002.
# VITE_SIDECAR_URL=http://127.0.0.1:3002
#
# Product debug bar (Flush / git-log). Also needs VITE_SIDECAR_URL.
# VITE_DEBUG=1
#
# Catalog / header data-testid hooks (Playwright m4).
# VITE_TESTIDS=1
